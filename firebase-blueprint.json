{
  "entities": {
    "Business": {
      "title": "Business",
      "description": "Local business profile in Orleans and Ottawa",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique business identifier" },
        "name": { "type": "string", "description": "Name of the business", "maxLength": 100 },
        "slug": { "type": "string", "description": "URL-friendly business slug", "maxLength": 100 },
        "description": { "type": "string", "description": "Short description of the business", "maxLength": 300 },
        "longDescription": { "type": "string", "description": "Full overview description", "maxLength": 2000 },
        "category": { "type": "string", "description": "Primary business category", "maxLength": 50 },
        "categorySlug": { "type": "string", "description": "Category slug", "maxLength": 50 },
        "subcategory": { "type": "string", "description": "Subcategory or cuisine", "maxLength": 50 },
        "address": { "type": "string", "description": "Street address in Orleans", "maxLength": 150 },
        "neighbourhood": { "type": "string", "description": "Orleans neighbourhood", "maxLength": 50 },
        "latitude": { "type": "number", "description": "Geographic latitude coordinate" },
        "longitude": { "type": "number", "description": "Geographic longitude coordinate" },
        "phone": { "type": "string", "description": "Contact telephone number", "maxLength": 30 },
        "website": { "type": "string", "description": "Official business website", "maxLength": 200 },
        "email": { "type": "string", "description": "Business contact email", "maxLength": 100 },
        "isOpenNow": { "type": "boolean", "description": "Whether the business is open right now" },
        "closingTime": { "type": "string", "description": "Upcoming closing time", "maxLength": 20 },
        "rating": { "type": "number", "description": "Average community star rating" },
        "reviewCount": { "type": "number", "description": "Total count of reviews" },
        "priceLevel": { "type": "string", "description": "Price level indicator", "enum": ["$", "$$", "$$$", "$$$$"] },
        "distanceKm": { "type": "number", "description": "Distance in km from centre" },
        "verified": { "type": "boolean", "description": "Whether listing is verified by moderators" },
        "claimed": { "type": "boolean", "description": "Whether listing has been claimed by owner" },
        "yearEstablished": { "type": "number", "description": "Founding year" }
      },
      "required": ["id", "name", "category", "address", "neighbourhood", "phone"]
    },
    "Review": {
      "title": "Review",
      "description": "User review and recommendation for a local business",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique review identifier" },
        "businessId": { "type": "string", "description": "Target business ID", "maxLength": 128 },
        "authorId": { "type": "string", "description": "Author UID", "maxLength": 128 },
        "authorName": { "type": "string", "description": "Author display name", "maxLength": 100 },
        "rating": { "type": "number", "description": "Rating out of 5 stars" },
        "text": { "type": "string", "description": "Review text content", "maxLength": 1000 },
        "helpfulCount": { "type": "number", "description": "Helpful reaction count" },
        "createdAt": { "type": "string", "description": "Creation timestamp ISO string", "maxLength": 40 }
      },
      "required": ["id", "businessId", "authorId", "authorName", "rating", "text"]
    },
    "BusinessSubmission": {
      "title": "BusinessSubmission",
      "description": "Submission for a new local business listing",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique submission identifier" },
        "userId": { "type": "string", "description": "Submitter UID", "maxLength": 128 },
        "businessName": { "type": "string", "description": "Business name", "maxLength": 100 },
        "category": { "type": "string", "description": "Category name", "maxLength": 50 },
        "neighbourhood": { "type": "string", "description": "Neighbourhood in Orleans", "maxLength": 50 },
        "address": { "type": "string", "description": "Street address", "maxLength": 150 },
        "phone": { "type": "string", "description": "Phone number", "maxLength": 30 },
        "email": { "type": "string", "description": "Contact email", "maxLength": 100 },
        "website": { "type": "string", "description": "Website URL", "maxLength": 200 },
        "description": { "type": "string", "description": "Business description", "maxLength": 1000 },
        "services": { "type": "string", "description": "Key services offered", "maxLength": 300 },
        "status": { "type": "string", "description": "Moderation status", "enum": ["pending", "approved", "rejected"] },
        "submittedAt": { "type": "string", "description": "Submission date", "maxLength": 40 }
      },
      "required": ["id", "userId", "businessName", "category", "neighbourhood", "address", "phone", "email", "description", "status"]
    },
    "Claim": {
      "title": "Claim",
      "description": "Owner verification claim for an existing business listing",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique claim identifier" },
        "businessId": { "type": "string", "description": "Claimed business ID", "maxLength": 128 },
        "userId": { "type": "string", "description": "Claimant UID", "maxLength": 128 },
        "userEmail": { "type": "string", "description": "Claimant email address", "maxLength": 100 },
        "claimNotes": { "type": "string", "description": "Verification proof and details", "maxLength": 500 },
        "status": { "type": "string", "description": "Claim status", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "description": "Claim timestamp", "maxLength": 40 }
      },
      "required": ["id", "businessId", "userId", "userEmail", "claimNotes", "status"]
    },
    "UserSavedPlace": {
      "title": "UserSavedPlace",
      "description": "Bookmarked business saved to user profile",
      "type": "object",
      "properties": {
        "businessId": { "type": "string", "description": "Saved business ID", "maxLength": 128 },
        "savedAt": { "type": "string", "description": "Saved timestamp", "maxLength": 40 }
      },
      "required": ["businessId", "savedAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "System administrator record",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Admin email", "maxLength": 100 },
        "role": { "type": "string", "description": "Admin role identifier", "maxLength": 50 }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/businesses/{businessId}": {
      "schema": "Business",
      "description": "Public local business directory listings"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Community reviews for Orleans businesses"
    },
    "/submissions/{submissionId}": {
      "schema": "BusinessSubmission",
      "description": "Business listing submissions pending moderator approval"
    },
    "/claims/{claimId}": {
      "schema": "Claim",
      "description": "Business ownership claims submitted by owners"
    },
    "/users/{userId}/saved/{businessId}": {
      "schema": "UserSavedPlace",
      "description": "User bookmarked favorite places"
    },
    "/admins/{userId}": {
      "schema": "Admin",
      "description": "Designated directory administrators"
    }
  }
}
